## The requirements, checked live

Each requirement for the app, checked against the running stack and the repo.

````elixir
defmodule Tour.Core.Scorecard do
  @moduledoc """
  Grades the app's requirements one by one, from evidence the notebook gathered from the
  running stack and the repo.
  """

  @type row :: %{ask: String.t(), level: :ok | :error, evidence: String.t()}

  @app_reasons ~w(missing_id invalid_format year_out_of_range catalog_unavailable)
  @rule_files [
    "derived-error-ratio.yaml",
    "drop-health-checks.yaml",
    "rollup-http-requests-total.yaml"
  ]

  @doc "One row per requirement, judged from `facts`."
  @spec rows(map()) :: [row()]
  def rows(facts) do
    [
      service(facts.listed),
      validity(facts.junk),
      log_line(facts.log),
      app_errors(facts.error_reasons),
      instrument(
        facts.catalog,
        "A histogram tracking latency",
        "kev_process_duration_seconds",
        "histogram"
      ),
      instrument(facts.catalog, "A success counter", "kev_process_success_total", "counter"),
      instrument(facts.catalog, "An errors counter", "kev_process_errors_total", "counter"),
      instrument(facts.catalog, "A gauge", "kev_catalog_age_seconds", "gauge"),
      readme(facts.readme, "README: setup instructions", "## Run it"),
      readme(facts.readme, "README: run commands", "make up"),
      promql_count(facts.readme),
      scraping(facts.targets),
      shaping(facts.rule_files),
      rollup(facts.rule)
    ]
  end

  defp service({:ok, %{status: 200, body: %{"cve_id" => id}, ms: ms}}),
    do:
      row(
        "An HTTP service with `/process?id=...`",
        :ok,
        "`/process?id=#{id}` answered 200 in #{Float.round(ms, 1)} ms."
      )

  defp service(other), do: row("An HTTP service with `/process?id=...`", :error, failure(other))

  defp validity({:ok, %{status: 400, body: %{"error" => "invalid_format"}}}),
    do:
      row(
        "A trivial operation: is the ID valid?",
        :ok,
        "`/process?id=123` answered 400 `invalid_format`."
      )

  defp validity(other), do: row("A trivial operation: is the ID valid?", :error, failure(other))

  defp log_line({:ok, container, _line}),
    do:
      row(
        "A log line per lookup",
        :ok,
        "Found that lookup's JSON line in `#{container}` by its request ID."
      )

  defp log_line(:error),
    do: row("A log line per lookup", :error, "Couldn't find the lookup's log line.")

  defp app_errors(reasons) do
    case Enum.filter(reasons, &(&1 in @app_reasons)) do
      [] ->
        row(
          "An error counter from app logic, not HTTP status",
          :error,
          "No app-level reasons on `kev_process_errors_total`."
        )

      found ->
        row(
          "An error counter from app logic, not HTTP status",
          :ok,
          "`kev_process_errors_total{reason}` counts #{Enum.join(found, ", ")}."
        )
    end
  end

  defp instrument(catalog, ask, name, type) do
    case Enum.find(catalog, &(&1.name == name and &1.type == type)) do
      %{help: help} -> row(ask, :ok, "`#{name}`, a #{type}: #{help}")
      nil -> row(ask, :error, "No #{type} named `#{name}` on `/metrics`.")
    end
  end

  defp readme({:ok, text}, ask, marker) do
    if String.contains?(text, marker),
      do: row(ask, :ok, "README.md has `#{marker}`."),
      else: row(ask, :error, "README.md has no `#{marker}`.")
  end

  defp readme({:error, _reason}, ask, _marker), do: row(ask, :error, "Couldn't read README.md.")

  defp promql_count({:ok, text}) do
    case length(Regex.scan(~r/```promql/, text)) do
      count when count >= 2 ->
        row("README: two PromQL queries", :ok, "README.md has #{count} PromQL blocks.")

      count ->
        row("README: two PromQL queries", :error, "README.md has #{count} PromQL blocks.")
    end
  end

  defp promql_count({:error, _reason}),
    do: row("README: two PromQL queries", :error, "Couldn't read README.md.")

  defp scraping({:ok, targets}) do
    apps = Enum.filter(targets, &(get_in(&1, ["labels", "job"]) == "kev-check"))

    case Enum.count(apps, &(&1["health"] == "up")) do
      0 ->
        row("A local Prometheus scraping the app", :error, "No app target is up.")

      up ->
        row(
          "A local Prometheus scraping the app",
          :ok,
          "Prometheus scrapes #{up} of #{length(apps)} app containers, every 15s."
        )
    end
  end

  defp scraping({:error, reason}), do: row("A local Prometheus scraping the app", :error, reason)

  defp shaping({:ok, files}) do
    case @rule_files -- files do
      [] ->
        row(
          "Drop, recording, roll-up, and derived rules",
          :ok,
          "Drop, roll-up, and derived examples are in `chronosphere/`, recording rules in `ops/prometheus/rules.yml`."
        )

      missing ->
        row(
          "Drop, recording, roll-up, and derived rules",
          :error,
          "Missing from `chronosphere/`: #{Enum.join(missing, ", ")}."
        )
    end
  end

  defp shaping({:error, _reason}),
    do: row("Drop, recording, roll-up, and derived rules", :error, "No `chronosphere/` folder.")

  defp rollup(%{same?: true, checks: checks}) do
    case for({text, false} <- checks, do: text) do
      [] ->
        row(
          "The roll-up rule, in chronoctl format",
          :ok,
          "`chronosphere/rollup-http-requests-total.yaml` meets all #{length(checks)} requirements."
        )

      unmet ->
        row("The roll-up rule, in chronoctl format", :error, "Unmet: #{Enum.join(unmet, "; ")}.")
    end
  end

  defp rollup(_different),
    do:
      row(
        "The roll-up rule, in chronoctl format",
        :error,
        "The committed file doesn't match the required rule."
      )

  defp failure({:ok, %{status: status}}), do: "Answered HTTP #{status}."
  defp failure({:error, reason}), do: reason

  defp row(ask, level, evidence), do: %{ask: ask, level: level, evidence: evidence}
end
````

````elixir
defmodule Tour.ScorecardTest do
  use ExUnit.Case, async: true

  alias Tour.Core.RollupRule
  alias Tour.Core.Scorecard

  @good %{
    listed: {:ok, %{status: 200, body: %{"cve_id" => "CVE-2021-44228"}, ms: 12.0}},
    junk: {:ok, %{status: 400, body: %{"error" => "invalid_format"}}},
    log: {:ok, "kev-check-app-1", "{}"},
    error_reasons: ["invalid_format", "missing_id"],
    catalog: [
      %{name: "kev_process_duration_seconds", type: "histogram", help: "h"},
      %{name: "kev_process_success_total", type: "counter", help: "s"},
      %{name: "kev_process_errors_total", type: "counter", help: "e"},
      %{name: "kev_catalog_age_seconds", type: "gauge", help: "g"}
    ],
    readme: {:ok, "## Run it\nmake up\n```promql\na\n```\n```promql\nb\n```"},
    targets: {:ok, [%{"labels" => %{"job" => "kev-check"}, "health" => "up"}]},
    rule_files:
      {:ok,
       ["derived-error-ratio.yaml", "drop-health-checks.yaml", "rollup-http-requests-total.yaml"]},
    rule: %{same?: true, checks: RollupRule.check(RollupRule.required())}
  }

  test "a healthy stack passes every row" do
    rows = Scorecard.rows(@good)
    assert length(rows) == 14
    assert Enum.all?(rows, &(&1.level == :ok))
  end

  test "a stack that's down fails with reasons, and nothing crashes" do
    down = %{
      @good
      | listed: {:error, "The app isn't answering"},
        junk: {:error, "The app isn't answering"},
        log: :error,
        error_reasons: [],
        catalog: [],
        targets: {:error, "Prometheus isn't answering"}
    }

    failed = for %{level: :error, ask: ask} <- Scorecard.rows(down), do: ask
    assert "An HTTP service with `/process?id=...`" in failed
    assert "A gauge" in failed
    assert length(failed) == 9
  end
end

ExUnit.run()
````

```elixir
defmodule Tour.Scorecard do
  @moduledoc """
  Gathers the evidence for the requirements scorecard, from the app, a container's `/metrics`,
  the logs, Prometheus, and the repo, then shows the grades.
  """

  alias Tour.Core.Exposition
  alias Tour.Core.RollupRule

  @doc "The scorecard as a table."
  @spec board() :: Kino.Markdown.t()
  def board do
    rows =
      for row <- Tour.Core.Scorecard.rows(gather()),
          do: [Tour.UI.mark(row.level), row.ask, row.evidence]

    Tour.UI.table(["", "Requirement", "Evidence"], rows)
  end

  defp gather do
    listed = Tour.App.lookup("CVE-2021-44228")
    metrics = metrics()
    repo = Tour.Config.repo()

    %{
      listed: listed,
      junk: Tour.App.lookup("123"),
      log: log(listed),
      error_reasons: Exposition.label_values(metrics, "kev_process_errors_total", "reason"),
      catalog: Exposition.catalog(metrics),
      readme: File.read(Path.join(repo, "README.md")),
      targets: Tour.Prom.targets(),
      rule_files: File.ls(Path.join(repo, "chronosphere")),
      rule: rule(Path.join(repo, "chronosphere/rollup-http-requests-total.yaml"))
    }
  end

  defp log({:ok, %{request_id: request_id}}), do: Tour.Docker.find_log(request_id)
  defp log({:error, _reason}), do: :error

  defp metrics do
    with [container | _others] <- Tour.Docker.apps(),
         {:ok, text} <- Tour.App.metrics(container.ports[9568]) do
      Exposition.parse(text)
    else
      _not_running -> Exposition.parse("")
    end
  end

  defp rule(path) do
    required = RollupRule.required()

    case File.read(path) do
      {:ok, committed} ->
        %{
          same?: RollupRule.same?(RollupRule.to_yaml(required), committed),
          checks: RollupRule.check(required)
        }

      {:error, _reason} ->
        %{same?: false, checks: []}
    end
  end
end
```

```elixir
regrade = Kino.Control.button("Grade it again")
scorecard = Tour.UI.frame()
Tour.UI.draw(scorecard, &Tour.Scorecard.board/0)
Kino.listen(regrade, fn _click -> Tour.UI.draw(scorecard, &Tour.Scorecard.board/0) end)
Tour.UI.stack([regrade, scorecard])
```

## Wrap up

Reset faults restores every container's fault settings and unpauses the load generator. Back to two containers undoes Scale.

```elixir
tidy = Kino.Control.button("Reset faults")
two = Kino.Control.button("Back to two containers")
stop = Kino.Control.button("■ Stop (make down)")
after_out = Tour.UI.frame()

Kino.listen(tidy, fn _click -> Tour.UI.draw(after_out, &Tour.UI.reset_everything/0) end)
Kino.listen(two, fn _click -> Tour.UI.run_in(after_out, "make", ["scale", "N=2"]) end)
Kino.listen(stop, fn _click -> Tour.UI.run_in(after_out, "make", ["down"]) end)
Tour.UI.stack([Kino.Layout.grid([tidy, two, stop], columns: 3), after_out])
```
