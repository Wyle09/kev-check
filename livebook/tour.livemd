`Tour.AlertDesk` reads the burn rates and alert states every 5 seconds.

```elixir
defmodule Tour.AlertDesk do
  @moduledoc """
  Section 6's board: the burn-rate meters and every alert's state, read fresh from Prometheus
  and Alertmanager.
  """

  alias Tour.Core.AlertBoard
  alias Tour.Core.Budget

  @doc "The board, saying how long ago faults went in when `since` holds that moment."
  @spec board({DateTime.t(), String.t()} | nil) :: Kino.Layout.t()
  def board(since) do
    now = DateTime.utc_now()
    Tour.UI.stack([since_note(since, now), meters(), alerts(now)])
  end

  defp since_note(nil, _now), do: Tour.UI.note(:info, "No faults applied from here right now.")

  defp since_note({at, what}, now),
    do:
      Tour.UI.note(
        :info,
        "Applied **#{what}** #{AlertBoard.elapsed(DateTime.diff(now, at))} ago."
      )

  defp meters do
    ratios =
      Map.new(
        ["5m", "30m", "1h", "6h"],
        &{&1, ratio(~s|kev:http_errors:ratio_rate#{&1}{env="production"}|)}
      )

    rows =
      for meter <- Budget.meters(ratios) do
        [
          if(meter.over?, do: "🔥", else: "·"),
          meter.window,
          Tour.UI.percent(meter.ratio),
          burn(meter.burn),
          "#{meter.threshold}×, #{meter.severity}"
        ]
      end

    slow = ratio(~s|kev:process_slow:ratio_rate5m{env="production"}|)

    note =
      "Share of lookups over 250 ms, last 5 minutes: **#{Tour.UI.percent(slow)}**. Slow lookups pages over 5%."

    Tour.UI.stack([
      Tour.UI.table(["", "Window", "5xx share", "Burn rate", "Alert threshold"], rows),
      Kino.Markdown.new(note)
    ])
  end

  defp alerts(now) do
    routed =
      case Tour.Alertmanager.alerts() do
        {:ok, alerts} -> alerts
        {:error, _reason} -> []
      end

    case Tour.Prom.alert_rules() do
      {:ok, rules} ->
        rows =
          for row <- AlertBoard.rows(rules, routed, now),
              do: [
                Tour.UI.mark(row.state),
                row.name,
                row.state,
                row.severity,
                row.wait,
                row.active_for,
                row.receiver
              ]

        Tour.UI.table(
          ["", "Alert", "State", "Severity", "Waits", "Active for", "Sent to"],
          rows
        )

      {:error, reason} ->
        Tour.UI.note(:error, reason)
    end
  end

  defp ratio(expr) do
    case Tour.Prom.query(expr) do
      {:ok, [%{value: value} | _rest]} -> value
      _missing -> nil
    end
  end

  defp burn(rate) when is_number(rate) do
    case Budget.days_left(rate) do
      :forever ->
        "#{Float.round(rate * 1.0, 1)}×"

      days ->
        "#{Float.round(rate * 1.0, 1)}×, a month's budget gone in #{Float.round(days, 1)} days"
    end
  end

  defp burn(:no_traffic), do: "no traffic"
  defp burn(_missing), do: "no data"
end
```

Set latency and error rate, then press Apply. Latency is the maximum per lookup; 25 ms is the default. Reset faults restores the defaults.

```elixir
targets = [{:all, "every app container"} | Enum.map(Tour.Docker.apps(), &{&1.name, &1.name})]

knobs =
  Kino.Control.form(
    [
      latency_ms:
        Kino.Input.range("Latency, up to this many ms", min: 0, max: 1000, step: 25, default: 25),
      error_rate:
        Kino.Input.range("Error rate (0.2 is 20%)", min: 0, max: 0.5, step: 0.05, default: 0.0),
      target: Kino.Input.select("Apply to", targets)
    ],
    submit: "Apply"
  )

reset_faults = Kino.Control.button("Reset faults")
applied = Tour.UI.frame()
desk = Tour.UI.frame()

apply_faults = fn %{latency_ms: ms, error_rate: rate, target: target} ->
  names = if target == :all, do: Enum.map(Tour.Docker.apps(), & &1.name), else: [target]
  results = Enum.map(names, &{&1, Tour.Docker.put_faults(&1, round(ms), rate)})

  rows =
    for {name, result} <- results do
      case result do
        {:ok, %{current: settings}} ->
          [Tour.UI.mark(:ok), name, Tour.Core.Faults.describe(settings)]

        {:error, reason} ->
          [Tour.UI.mark(:error), name, reason]
      end
    end

  Kino.Frame.render(applied, Tour.UI.table(["", "Container", "Now"], rows))

  {DateTime.utc_now(),
   "up to #{round(ms)} ms, #{round(rate * 100)}% errors on #{Enum.join(names, ", ")}"}
end

events =
  Kino.Control.tagged_stream(
    apply: knobs,
    reset: reset_faults,
    tick: Kino.Control.interval(5_000)
  )

Kino.listen(events, nil, fn
  {:apply, %{data: data}}, _since ->
    {:cont, apply_faults.(data)}

  {:reset, _click}, _since ->
    Tour.UI.draw(applied, &Tour.UI.reset_everything/0)
    {:cont, nil}

  {:tick, _tick}, since ->
    Tour.UI.draw(desk, fn -> Tour.AlertDesk.board(since) end)
    {:cont, since}
end)

Tour.UI.draw(desk, fn -> Tour.AlertDesk.board(nil) end)

Tour.UI.stack([
  knobs,
  reset_faults,
  applied,
  desk,
  Kino.Markdown.new(
    "[Prometheus alerts ↗](http://localhost:9090/alerts) · [Alertmanager ↗](http://localhost:9093)"
  )
])
