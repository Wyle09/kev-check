## 6. Alerting

The alerts page on symptoms users see and open tickets for causes, and they evaluate the whole environment rather than single containers. The SLO is 99.9% of lookups succeeding and 95% finishing within 250 ms, which leaves an error budget of 0.1% a month.

The fast-burn alert fires when more than 1.44% of requests fail over both the last 5 minutes and the last hour. That's 14.4 times the budget rate, enough to spend a month's budget in about two days. Rules group by `env`, so they keep working after the roll-up removes `pod`.

A page takes about 7 minutes after errors start: the 1 hour ratio needs about 5 minutes to pass 1.44%, then the rule waits 2 minutes. Applying a 20% error rate before section 3 has it firing by the time you get here.

`Tour.Core.Budget` computes burn rates. A ratio of NaN means there was no traffic in the window. `Tour.Core.AlertBoard` combines Prometheus's alert rules with Alertmanager's routing.

```elixir
defmodule Tour.Core.Budget do
  @moduledoc """
  Error-budget arithmetic for the 99.9% SLO: how fast a failure ratio spends the budget, and
  which burn-rate pair it trips.
  """

  @allowed 0.001
  @pairs [
    {"5m", 14.4, "page"},
    {"1h", 14.4, "page"},
    {"30m", 6.0, "ticket"},
    {"6h", 6.0, "ticket"}
  ]

  @type burn :: float() | :no_traffic | :no_data
  @type meter :: %{
          window: String.t(),
          ratio: term(),
          burn: burn(),
          threshold: float(),
          severity: String.t(),
          over?: boolean()
        }

  @doc "How many times faster than allowed `ratio` spends the budget. NaN means nothing was requested."
  @spec burn_rate(term()) :: burn()
  def burn_rate(:nan), do: :no_traffic
  def burn_rate(ratio) when is_number(ratio), do: ratio / @allowed
  def burn_rate(_missing), do: :no_data

  @doc "The four burn-rate meters, from the recorded ratios keyed by window."
  @spec meters(%{String.t() => term()}) :: [meter()]
  def meters(ratios) do
    for {window, threshold, severity} <- @pairs do
      ratio = Map.get(ratios, window)
      burn = burn_rate(ratio)

      %{
        window: window,
        ratio: ratio,
        burn: burn,
        threshold: threshold,
        severity: severity,
        over?: is_number(burn) and burn > threshold
      }
    end
  end

  @doc "Days a month's budget lasts at `burn` times the allowed rate."
  @spec days_left(burn()) :: float() | :forever
  def days_left(burn) when is_number(burn) and burn > 0, do: 30 / burn
  def days_left(_no_burn), do: :forever
end
```

```elixir
defmodule Tour.Core.AlertBoard do
  @moduledoc """
  Joins Prometheus's alerting rules with Alertmanager's routing into one row per alert, the
  worst state first.
  """

  @order %{"firing" => 0, "pending" => 1, "inactive" => 2}

  @type row :: %{
          name: String.t(),
          state: String.t(),
          severity: String.t() | nil,
          wait: String.t(),
          active_for: String.t(),
          receiver: String.t()
        }

  @doc "One row per rule: state, severity, how long it's been active, and where Alertmanager sent it."
  @spec rows([map()], [map()], DateTime.t()) :: [row()]
  def rows(rules, routed, now) do
    receivers = Map.new(routed, &{&1["labels"]["alertname"], receivers(&1)})

    rules
    |> Enum.map(&row(&1, receivers, now))
    |> Enum.sort_by(&{Map.get(@order, &1.state, 3), &1.name})
  end

  @doc "Seconds as `45s`, `2m`, `3m 12s`, or `1h 5m`."
  @spec elapsed(integer()) :: String.t()
  def elapsed(seconds) when seconds < 60, do: "#{seconds}s"

  def elapsed(seconds) when seconds >= 3600,
    do: "#{div(seconds, 3600)}h #{div(rem(seconds, 3600), 60)}m"

  def elapsed(seconds) when rem(seconds, 60) == 0, do: "#{div(seconds, 60)}m"
  def elapsed(seconds), do: "#{div(seconds, 60)}m #{rem(seconds, 60)}s"

  defp row(%{"name" => name, "state" => state} = rule, receivers, now) do
    %{
      name: name,
      state: state,
      severity: get_in(rule, ["labels", "severity"]),
      wait: elapsed(round(Map.get(rule, "duration", 0))),
      active_for: active_for(Map.get(rule, "alerts", []), now),
      receiver: Map.get(receivers, name, "")
    }
  end

  defp active_for([%{"activeAt" => at} | _others], now) do
    case DateTime.from_iso8601(at) do
      {:ok, since, _offset} -> elapsed(DateTime.diff(now, since))
      {:error, _reason} -> ""
    end
  end

  defp active_for(_none, _now), do: ""

  defp receivers(%{"receivers" => receivers}), do: Enum.map_join(receivers, ", ", & &1["name"])
end
```

```elixir
defmodule Tour.AlertingTest do
  use ExUnit.Case, async: true

  alias Tour.Core.AlertBoard
  alias Tour.Core.Budget

  test "burn rates, and NaN reads as no traffic" do
    assert_in_delta Budget.burn_rate(0.0144), 14.4, 1.0e-9
    assert Budget.burn_rate(:nan) == :no_traffic
    assert Budget.burn_rate(nil) == :no_data
    assert_in_delta Budget.days_left(14.4), 2.08, 0.01
  end

  test "20% failing trips the fast pair, which pages" do
    meters = Budget.meters(%{"5m" => 0.2, "1h" => 0.02, "30m" => 0.0, "6h" => :nan})

    assert [
             %{window: "5m", over?: true, severity: "page"},
             %{window: "1h", over?: true},
             %{window: "30m", over?: false, severity: "ticket"},
             %{window: "6h", burn: :no_traffic, over?: false}
           ] = meters
  end

  test "alerts sort firing first and pick up their Alertmanager receiver" do
    rules = [
      %{
        "name" => "KevCheckSlowLookups",
        "state" => "inactive",
        "labels" => %{"severity" => "page"},
        "duration" => 120
      },
      %{
        "name" => "KevCheckErrorBudgetFastBurn",
        "state" => "firing",
        "labels" => %{"severity" => "page"},
        "duration" => 120,
        "alerts" => [%{"activeAt" => "2026-10-15T23:22:42.874564729Z"}]
      }
    ]

    routed = [
      %{
        "labels" => %{"alertname" => "KevCheckErrorBudgetFastBurn"},
        "receivers" => [%{"name" => "pager"}]
      }
    ]

    assert [
             %{
               name: "KevCheckErrorBudgetFastBurn",
               active_for: "3m 12s",
               receiver: "pager",
               wait: "2m"
             },
             %{name: "KevCheckSlowLookups", active_for: "", receiver: ""}
           ] = AlertBoard.rows(rules, routed, ~U[2026-10-15 23:25:54.874564Z])
  end
end

ExUnit.run()
