## 1. The question KEV check answers

CISA's Known Exploited Vulnerabilities catalog lists about 1,700 CVEs known to be exploited. `GET /process?id=` says whether an ID is on it and, if so, returns the vendor, product, and patch due date. An ID that isn't listed is a successful answer. Invalid input or a missing catalog is an error.

Errors are counted by the app's reason, not the HTTP status: `123` returns 400 and increments `kev_process_errors_total{reason="invalid_format"}`.

```elixir
presets = [
  {"Log4Shell", "CVE-2021-44228"},
  {"Messy but valid", "  cve-2023-4966 "},
  {"Not on the list", "CVE-2023-99999"},
  {"Not a CVE", "123"},
  {"From the future", "CVE-2099-0001"},
  {"Empty", ""}
]

look_up =
  Kino.Control.form([id: Kino.Input.text("CVE ID", default: "CVE-2021-44228")], submit: "Look up")

preset_buttons = Enum.map(presets, fn {label, value} -> {Kino.Control.button(label), value} end)
answer = Tour.UI.frame("Pick a preset or type an ID, then press Look up.")

headline = fn
  %{status: 200, body: %{"known_exploited" => true} = body} ->
    ransomware = if body["known_ransomware_use"], do: "yes", else: "not known"

    """
    🚨 **#{body["cve_id"]} is on the KEV list.** #{body["vendor"]} #{body["product"]}: #{body["name"]}.

    Added #{body["date_added"]}, due #{body["due_date"]}. Used in ransomware: #{ransomware}. CISA says: #{body["required_action"]}
    """

  %{status: 200, body: body} ->
    "🟢 **#{body["cve_id"]} isn't on the list**, as of catalog #{body["catalog_version"]}. Counted as a success."

  %{status: status, body: %{"error" => error, "message" => message}} ->
    "⛔ **HTTP #{status}, `#{error}`.** #{message} The errors counter records `reason=\"#{error}\"`."

  %{status: status, body: body} ->
    "**HTTP #{status}** #{inspect(body)}"
end

show = fn value ->
  Tour.UI.draw(answer, fn ->
    case Tour.App.lookup(value) do
      {:ok, reply} ->
        meta =
          "`GET /process?id=#{value}` · #{Float.round(reply.ms, 1)} ms · request `#{reply.request_id}`"

        Tour.UI.stack([
          Kino.Markdown.new(headline.(reply) <> "\n\n" <> meta),
          Kino.Tree.new(reply.body)
        ])

      {:error, reason} ->
        Tour.UI.note(:error, reason)
    end
  end)
end

Kino.listen(look_up, fn %{data: %{id: value}} -> show.(value) end)

Enum.each(preset_buttons, fn {button, value} ->
  Kino.listen(button, fn _click -> show.(value) end)
end)

Tour.UI.stack([
  look_up,
  Kino.Layout.grid(for({button, _value} <- preset_buttons, do: button), columns: 3),
  answer
])
```

## 2. One request, five signals

The app has five instrumentation points: a latency histogram, a success counter, an errors counter, a gauge, and a log line.

One telemetry span wraps each lookup (`lib/kev_check/lookup.ex`), and its stop event feeds the histogram, both counters, and the log line. The experiment below pauses the load generator, reads one container's `/metrics`, sends that container one lookup, reads `/metrics` again, and shows which series changed, with the lookup's log line.

`Tour.Core.Exposition` parses the Prometheus text format and diffs two scrapes.

```elixir
defmodule Tour.Core.Exposition do
  @moduledoc """
  Reads the Prometheus text format an app serves on `/metrics`, and compares two reads to
  show which series moved.
  """

  alias Tour.Core.PromJSON

  @type t :: %{
          samples: %{String.t() => PromJSON.value()},
          types: %{String.t() => String.t()},
          help: %{String.t() => String.t()}
        }
  @type change :: %{
          series: String.t(),
          family: String.t(),
          type: String.t() | nil,
          before: PromJSON.value() | nil,
          after: PromJSON.value() | nil
        }

  @sample ~r/^([a-zA-Z_:][a-zA-Z0-9_:]*)(\{.*\})?\s+(\S+)/

  @doc "Parse a `/metrics` page into its samples, types, and help texts."
  @spec parse(String.t()) :: t()
  def parse(text) do
    text
    |> String.split("\n", trim: true)
    |> Enum.reduce(%{samples: %{}, types: %{}, help: %{}}, &read_line/2)
  end

  @doc "The metric families a page declares, from its own `# HELP` and `# TYPE` lines."
  @spec catalog(t()) :: [%{name: String.t(), type: String.t(), help: String.t()}]
  def catalog(%{types: types, help: help}) do
    types
    |> Enum.map(fn {name, type} -> %{name: name, type: type, help: Map.get(help, name, "")} end)
    |> Enum.sort_by(& &1.name)
  end

  @doc "Every series whose value differs between two reads of the same page."
  @spec diff(t(), t()) :: [change()]
  def diff(%{samples: before}, %{samples: later, types: types}) do
    (Map.keys(before) ++ Map.keys(later))
    |> Enum.uniq()
    |> Enum.reject(&(Map.get(before, &1) == Map.get(later, &1)))
    |> Enum.sort()
    |> Enum.map(&change(&1, before, later, types))
  end

  @doc "The values one label takes on one metric, like every `reason` the errors counter has."
  @spec label_values(t(), String.t(), String.t()) :: [String.t()]
  def label_values(%{samples: samples}, metric, label) do
    pattern = ~r/^#{Regex.escape(metric)}\{.*#{Regex.escape(label)}="([^"]*)"/

    samples
    |> Map.keys()
    |> Enum.flat_map(&(Regex.run(pattern, &1, capture: :all_but_first) || []))
    |> Enum.uniq()
    |> Enum.sort()
  end

  @doc "A histogram bucket's upper edge in seconds, `:inf` for the last one, nil for other series."
  @spec le(String.t()) :: float() | :inf | nil
  def le(series) do
    case Regex.run(~r/le="([^"]+)"/, series, capture: :all_but_first) do
      [edge] -> PromJSON.value(edge)
      nil -> nil
    end
  end

  defp read_line("# HELP " <> rest, acc), do: put_meta(acc, :help, rest)
  defp read_line("# TYPE " <> rest, acc), do: put_meta(acc, :types, rest)
  defp read_line("#" <> _comment, acc), do: acc

  defp read_line(line, acc) do
    case Regex.run(@sample, line, capture: :all_but_first) do
      [name, labels, value] -> put_in(acc, [:samples, name <> labels], PromJSON.value(value))
      _not_a_sample -> acc
    end
  end

  defp put_meta(acc, key, rest) do
    case String.split(rest, " ", parts: 2) do
      [name, text] -> put_in(acc, [key, name], text)
      [name] -> put_in(acc, [key, name], "")
    end
  end

  defp change(series, before, later, types) do
    family = family(series, types)

    %{
      series: series,
      family: family,
      type: Map.get(types, family),
      before: Map.get(before, series),
      after: Map.get(later, series)
    }
  end

  # `x_bucket`, `x_sum`, and `x_count` all belong to histogram `x`.
  defp family(series, types) do
    name = series |> String.split("{") |> hd()
    base = String.replace(name, ~r/_(bucket|sum|count)$/, "")
    if Map.get(types, base) in ["histogram", "summary"], do: base, else: name
  end
end
```

```elixir
defmodule Tour.ExpositionTest do
  use ExUnit.Case, async: true

  alias Tour.Core.Exposition

  @before """
  # HELP kev_process_duration_seconds Time to answer one /process lookup.
  # TYPE kev_process_duration_seconds histogram
  kev_process_duration_seconds_bucket{le="0.01"} 4
  kev_process_duration_seconds_bucket{le="0.025"} 9
  kev_process_duration_seconds_bucket{le="+Inf"} 10
  kev_process_duration_seconds_sum 0.2
  kev_process_duration_seconds_count 10
  # TYPE kev_process_errors_total counter
  kev_process_errors_total{reason="invalid_format"} 3
  # TYPE kev_catalog_age_seconds gauge
  kev_catalog_age_seconds 100
  """

  test "the catalog comes from the page's own TYPE and HELP lines" do
    assert [
             %{name: "kev_catalog_age_seconds", type: "gauge"},
             %{
               name: "kev_process_duration_seconds",
               type: "histogram",
               help: "Time to answer one /process lookup."
             },
             %{name: "kev_process_errors_total", type: "counter"}
           ] = Exposition.catalog(Exposition.parse(@before))
  end

  test "a 20 ms lookup moves every bucket from 25 ms up, plus _sum and _count, and nothing else" do
    later =
      @before
      |> String.replace(~s(le="0.025"} 9), ~s(le="0.025"} 10))
      |> String.replace(~s(le="+Inf"} 10), ~s(le="+Inf"} 11))
      |> String.replace("_sum 0.2", "_sum 0.22")
      |> String.replace("_count 10", "_count 11")

    changes = Exposition.diff(Exposition.parse(@before), Exposition.parse(later))

    assert Enum.map(changes, & &1.series) == [
             ~s(kev_process_duration_seconds_bucket{le="+Inf"}),
             ~s(kev_process_duration_seconds_bucket{le="0.025"}),
             "kev_process_duration_seconds_count",
             "kev_process_duration_seconds_sum"
           ]

    assert Enum.all?(
             changes,
             &(&1.family == "kev_process_duration_seconds" and &1.type == "histogram")
           )
  end

  test "label values and bucket edges come out of series names" do
    parsed = Exposition.parse(@before)

    assert Exposition.label_values(parsed, "kev_process_errors_total", "reason") == [
             "invalid_format"
           ]

    assert Exposition.le(~s(x_bucket{le="0.025"})) == 0.025
    assert Exposition.le(~s(x_bucket{le="+Inf"})) == :inf
    assert Exposition.le("x_count") == nil
  end
end

ExUnit.run()
```

`Tour.OneRequest` runs the experiment. Its `after` block unpauses the load generator even if a step fails. `Tour.Signals` renders the result.

```elixir
defmodule Tour.OneRequest do
  @moduledoc """
  Section 2's experiment: pause the load generator, read one container's metrics, send it
  one lookup, read them again, and find the lookup's log line.
  """

  alias Tour.Core.Exposition

  @type result :: %{
          id: String.t(),
          container: String.t(),
          reply: Tour.App.reply(),
          changes: [Exposition.change()],
          log_line: String.t() | nil,
          paused?: boolean()
        }

  @doc "Send `id` straight to the first app container and report every series that moved."
  @spec run(String.t()) :: {:ok, result()} | {:error, String.t()}
  def run(id) do
    case Tour.Docker.apps() do
      [container | _others] -> paused(fn -> measure(container, id) end)
      [] -> {:error, "No app container is running. Press Start in the Control room."}
    end
  end

  # The pause stops new lookups. The second lets the ones already inside the app finish.
  defp paused(fun) do
    paused? = match?({:ok, _output}, Tour.Docker.loadgen(:pause))
    Process.sleep(1_000)
    with {:ok, result} <- fun.(), do: {:ok, Map.put(result, :paused?, paused?)}
  after
    Tour.Docker.loadgen(:unpause)
  end

  defp measure(container, id) do
    with {:ok, before} <- Tour.App.metrics(container.ports[9568]),
         {:ok, reply} <- Tour.App.lookup(id, Tour.App.direct(container)),
         {:ok, later} <- Tour.App.metrics(container.ports[9568]) do
      {:ok,
       %{
         id: id,
         container: container.name,
         reply: reply,
         changes: Exposition.diff(Exposition.parse(before), Exposition.parse(later)),
         log_line: log_line(reply.request_id)
       }}
    end
  end

  defp log_line(request_id) do
    case Tour.Docker.find_log(request_id) do
      {:ok, _container, line} -> line
      :error -> nil
    end
  end
end
```

```elixir
defmodule Tour.Signals do
  @moduledoc """
  Turns section 2's experiment into one card per instrumentation point, built from the
  series that actually moved.
  """

  alias Tour.Core.Exposition

  @histogram "kev_process_duration_seconds"

  @doc "A summary, then a card each for the histogram, both counters, the HTTP counter, the gauges, and the log line."
  @spec cards(Tour.OneRequest.result()) :: Kino.Layout.t()
  def cards(%{changes: changes} = result) do
    families = Enum.group_by(changes, & &1.family)

    middle = [
      counter("✅ Success counter", "kev_process_success_total", families),
      counter("⛔ Errors counter", "kev_process_errors_total", families),
      counter("🌐 HTTP requests", "http_requests_total", families),
      gauges(Enum.filter(changes, &(&1.type == "gauge")))
    ]

    Tour.UI.stack([
      Kino.Markdown.new(summary(result)),
      card(histogram(Map.get(families, @histogram, []))),
      Kino.Layout.grid(Enum.map(middle, &card/1), columns: 2),
      card(log(result.log_line))
    ])
  end

  defp summary(%{id: id, container: container, reply: reply, paused?: paused?}) do
    paused = if paused?, do: "paused", else: "not paused, so other lookups may show up too"

    "Sent `#{id}` straight to `#{container}`: HTTP #{reply.status} in #{Float.round(reply.ms, 1)} ms, " <>
      "request `#{reply.request_id}`. Load generator #{paused}."
  end

  defp card(markdown), do: Kino.Layout.grid([Kino.Markdown.new(markdown)], boxed: true)

  defp histogram([]), do: "#### 📊 Histogram\n`#{@histogram}` didn't move."

  defp histogram(changes) do
    edges =
      changes
      |> Enum.map(&Exposition.le(&1.series))
      |> Enum.reject(&is_nil/1)
      |> Enum.sort_by(&edge_order/1)
      |> Enum.map_join(" ", &"`#{edge_label(&1)}`")

    took =
      case Enum.find(changes, &(&1.series == @histogram <> "_sum")) do
        %{before: before, after: later} -> Tour.UI.ms(later - before)
        nil -> "no data"
      end

    """
    #### 📊 Histogram, `#{@histogram}`

    The lookup took **#{took}**. Buckets that went up by 1: #{edges}

    Each bucket counts every lookup at or under its edge, so one lookup lands in every bucket from its own edge up to `+Inf`. `_count` went up by 1, and `_sum` by the duration.
    """
  end

  defp counter(title, family, families) do
    case Map.get(families, family, []) do
      [] ->
        "#### #{title}\n`#{family}` didn't move."

      changes ->
        "#### #{title}\n`#{family}`\n\n" <>
          Enum.map_join(changes, "\n\n", &"`#{labels(&1, family)}` **+#{delta(&1)}**")
    end
  end

  defp gauges([]),
    do: """
    #### 🌡️ Gauges
    `kev_catalog_age_seconds` didn't move. A gauge records state (the catalog's age), not events, so a lookup doesn't change it.
    """

  defp gauges(changes) do
    """
    #### 🌡️ Gauges
    #{Enum.map_join(changes, "\n\n", &"`#{&1.series}` #{&1.before} → #{&1.after}")}

    These change on a 10 second timer, not because of the lookup.
    """
  end

  defp log(nil), do: "#### 📝 Log line\nI couldn't find it in the last 300 lines."

  defp log(line),
    do:
      "#### 📝 Log line\nThe CVE ID is logged rather than used as a label, since every new ID would be a new series. One JSON object per line, pretty-printed here:\n" <>
        Tour.UI.json_block(line)

  defp labels(%{series: series}, family), do: String.replace_prefix(series, family, "")

  defp delta(%{before: before, after: later}) when is_number(before) and is_number(later),
    do: round(later - before)

  defp delta(%{after: later}), do: "new, #{later}"

  defp edge_order(:inf), do: {1, 0}
  defp edge_order(edge), do: {0, edge}

  defp edge_label(:inf), do: "+Inf"
  defp edge_label(edge), do: "le=#{edge}"
end
```

The app's metrics, from one container's `# TYPE` and `# HELP` lines, with the reason for each type.

```elixir
why = %{
  "kev_process_duration_seconds" =>
    {"1 histogram tracking latency",
     "Bucket counts can be summed across containers before computing a quantile."},
  "kev_process_success_total" =>
    {"1 success counter",
     "Only goes up. `rate()` turns it into lookups per second and handles restarts."},
  "kev_process_errors_total" =>
    {"1 errors counter", "Counted by the app's `reason`, not the HTTP status."},
  "kev_catalog_age_seconds" =>
    {"1 gauge",
     "Age of the catalog in use. It drops when a refresh lands, so it can't be a counter."},
  "kev_catalog_entries" => {"", "Catalog size. A refresh can shrink it."},
  "http_requests_total" =>
    {"The roll-up's target",
     "Every response by method, route, and status. The alerts and the roll-up use it."},
  "vm_memory_total_bytes" => {"", "Memory allocated by the Erlang VM."},
  "vm_run_queue_length" =>
    {"", "Processes waiting for a scheduler. Sustained growth means CPU bound."}
}

catalog =
  with [container | _others] <- Tour.Docker.apps(),
       {:ok, text} <- Tour.App.metrics(container.ports[9568]) do
    rows =
      for %{name: name, type: type, help: help} <-
            Tour.Core.Exposition.catalog(Tour.Core.Exposition.parse(text)) do
        {point, reason} = Map.get(why, name, {"", ""})
        ["`#{name}`", type, point, reason, help]
      end

    log_row = [
      "one JSON line per lookup",
      "log",
      "1 log line",
      "Holds the CVE ID and raw input, which would be unbounded as labels.",
      ""
    ]

    Tour.UI.table(
      ["Metric", "Type", "Requirement", "Why this type", "The app's own help text"],
      rows ++ [log_row]
    )
  else
    _not_running ->
      Tour.UI.note(:error, "No app container is answering. Start the stack in the Control room.")
  end
```

Send one lookup. A listed ID increments the success counter and `123` the errors counter. Both move the histogram and `http_requests_total`.

```elixir
send_one =
  Kino.Control.form(
    [
      id:
        Kino.Input.select("ID to send", [
          {"CVE-2021-44228", "CVE-2021-44228 (on the list)"},
          {"CVE-2023-99999", "CVE-2023-99999 (not on the list)"},
          {"123", "123 (not a CVE)"}
        ])
    ],
    submit: "Send one request"
  )

signals = Tour.UI.frame("Press Send one request.")
moved = Tour.UI.frame()

Kino.listen(send_one, fn %{data: %{id: id}} ->
  Kino.Frame.render(
    signals,
    Tour.UI.note(:info, "Pausing the load generator and sending one lookup...")
  )

  Kino.Frame.render(moved, Kino.Markdown.new(""))

  Tour.UI.draw(signals, fn ->
    case Tour.OneRequest.run(id) do
      {:ok, result} ->
        rows = Enum.map(result.changes, &["`#{&1.series}`", &1.type, &1.before, &1.after])

        Kino.Frame.render(
          moved,
          Tour.UI.table(["Every series that moved", "Type", "Before", "After"], rows)
        )

        Tour.Signals.cards(result)

      {:error, reason} ->
        Tour.UI.note(:error, reason)
    end
  end)
end)

Tour.UI.stack([send_one, signals, moved])
```

## 3. Histogram x-ray

Prometheus stores histogram buckets as cumulative counts: `le="0.025"` counts lookups at or under 25 ms, and `le="+Inf"` counts all of them. `histogram_quantile` finds the bucket that holds the requested rank and interpolates linearly inside it, so the error is at most that bucket's width. The app's bucket edges:

````elixir
source = Path.join(Tour.Config.repo(), "lib/kev_check_web/telemetry.ex")

case File.read(source) do
  {:ok, text} ->
    lines =
      Regex.run(~r/  # Seconds\..*?@latency_buckets \[[^\]]+\]/s, text) ||
        ["@latency_buckets not found"]

    Kino.Markdown.new("`lib/kev_check_web/telemetry.ex`\n```elixir\n#{hd(lines)}\n```")

  {:error, reason} ->
    Tour.UI.note(:error, "Couldn't read #{source}: #{:file.format_error(reason)}")
end
````

`Tour.Core.Quantile` reimplements `histogram_quantile` and keeps each step. `walk/2` moves through adjacent buckets until the cumulative count reaches the rank, then interpolates. `when` adds a guard condition to a function clause.

```elixir
defmodule Tour.Core.Quantile do
  @moduledoc """
  Prometheus's `histogram_quantile`, rewritten so every step can be shown: find the bucket
  the rank falls in, then assume values are spread evenly inside it.
  """

  @type edge :: float() | :inf
  @type bucket :: {edge(), number()}
  @type estimate :: %{
          q: float(),
          total: number(),
          rank: float(),
          lower: float(),
          upper: edge(),
          below: number(),
          at_upper: number(),
          value: float()
        }

  @doc "Cumulative buckets from `le` samples, sorted by edge, with any dip flattened the way Prometheus does."
  @spec from_samples([%{labels: map(), value: term()}]) :: [bucket()]
  def from_samples(samples) do
    samples
    |> Enum.flat_map(&bucket/1)
    |> Enum.sort_by(&order/1)
    |> Enum.scan(fn {edge, count}, {_previous, floor} -> {edge, max(count, floor)} end)
  end

  @doc "Estimate quantile `q` from cumulative buckets ending in `+Inf`, or `:no_data` when they're empty."
  @spec estimate(float(), [bucket()]) :: estimate() | :no_data
  def estimate(q, buckets) when is_number(q) and q > 0 and q <= 1 do
    case List.last(buckets) do
      {:inf, total} when total > 0 ->
        walk([{0.0, 0} | buckets], %{q: q, total: total, rank: q * total})

      _empty ->
        :no_data
    end
  end

  @doc "Keep only the given finite edges, plus `+Inf`, to see what coarser buckets would have said."
  @spec keep_edges([bucket()], [float()]) :: [bucket()]
  def keep_edges(buckets, edges),
    do: Enum.filter(buckets, fn {edge, _count} -> edge == :inf or edge in edges end)

  # Past the last finite edge, Prometheus answers with that edge.
  defp walk([{lower, below}, {:inf, _total} | _rest], step),
    do:
      Map.merge(step, %{
        lower: lower,
        upper: :inf,
        below: below,
        at_upper: step.total,
        value: lower
      })

  defp walk([{lower, below}, {upper, at_upper} | _rest], %{rank: rank} = step)
       when at_upper >= rank do
    value = lower + (upper - lower) * (rank - below) / (at_upper - below)
    Map.merge(step, %{lower: lower, upper: upper, below: below, at_upper: at_upper, value: value})
  end

  defp walk([_passed | rest], step), do: walk(rest, step)

  defp bucket(%{labels: %{"le" => le}, value: count}) when is_number(count),
    do: [{Tour.Core.PromJSON.value(le), count}]

  defp bucket(_no_count), do: []

  defp order({:inf, _count}), do: {1, 0}
  defp order({edge, _count}), do: {0, edge}
end
```

```elixir
defmodule Tour.QuantileTest do
  use ExUnit.Case, async: true

  alias Tour.Core.Quantile

  @buckets [{0.1, 50}, {0.2, 90}, {:inf, 100}]

  test "worked examples, checked by hand" do
    for {q, expected} <- [{0.5, 0.1}, {0.7, 0.15}, {0.9, 0.2}, {0.95, 0.2}] do
      assert_in_delta Quantile.estimate(q, @buckets).value, expected, 1.0e-9
    end
  end

  test "the README's own example: 7.6 lookups under 25 ms, 8.105 under 50 ms" do
    estimate = Quantile.estimate(0.95, [{0.025, 7.6}, {0.05, 8.105}, {:inf, 8.105}])
    assert %{lower: 0.025, upper: 0.05} = estimate
    assert_in_delta estimate.value, 0.02994, 1.0e-5
  end

  test "an empty histogram has no answer, the way Prometheus returns NaN" do
    assert Quantile.estimate(0.95, [{0.1, 0}, {:inf, 0}]) == :no_data
    assert Quantile.estimate(0.95, []) == :no_data
  end

  test "samples arrive unsorted with string edges, and a dip is flattened" do
    samples = [
      %{labels: %{"le" => "+Inf"}, value: 10.0},
      %{labels: %{"le" => "0.25"}, value: 9.0},
      %{labels: %{"le" => "0.1"}, value: 9.5}
    ]

    assert Quantile.from_samples(samples) == [{0.1, 9.5}, {0.25, 9.5}, {:inf, 10.0}]
  end

  test "coarser buckets give a worse answer from the same data" do
    fine = [{0.01, 10}, {0.025, 95}, {0.05, 99}, {0.1, 100}, {:inf, 100}]
    coarse = Quantile.keep_edges(fine, [0.1])
    assert coarse == [{0.1, 100}, {:inf, 100}]
    assert Quantile.estimate(0.5, fine).value < Quantile.estimate(0.5, coarse).value
  end
end

ExUnit.run()
```

`Tour.XRay` queries the bucket counts and Prometheus's `histogram_quantile` at the same timestamp, computes the quantile with `Tour.Core.Quantile`, and shows both.

```elixir
defmodule Tour.XRay do
  @moduledoc """
  Section 3's reveal: fetch the buckets and Prometheus's own answer at the same instant,
  work the quantile out step by step, and chart the buckets.
  """

  alias Tour.Core.Quantile
  alias VegaLite, as: Vl

  @edge_sets %{decades: [0.01, 0.1, 1.0], slo: [0.25]}

  @doc "The whole reveal for a form with `:window`, `:q`, `:edges`, and `:guess`."
  @spec reveal(map()) :: Kino.Layout.t() | Kino.Markdown.t()
  def reveal(%{window: window, q: q} = form) do
    at = System.os_time(:second)

    buckets_expr =
      ~s|sum by (le) (increase(kev_process_duration_seconds_bucket{env="production"}[#{window}]))|

    answer_expr = "histogram_quantile(#{q}, #{buckets_expr})"

    with {:ok, samples} <- Tour.Prom.query(buckets_expr, time: at),
         {:ok, answer} <- Tour.Prom.query(answer_expr, time: at) do
      buckets = Quantile.from_samples(samples)
      draw(buckets, Quantile.estimate(q, buckets), prometheus_value(answer), form, answer_expr)
    else
      {:error, reason} -> Tour.UI.note(:error, reason)
    end
  end

  defp draw(_buckets, :no_data, _prometheus, _form, _expr),
    do: Tour.UI.note(:warn, "No lookups in that window. Is the load generator running?")

  defp draw(buckets, estimate, prometheus, form, expr) do
    Tour.UI.stack([
      Kino.Markdown.new(steps(estimate) <> "\n" <> verdict(estimate, prometheus, form.guess)),
      charts(buckets, estimate),
      coarse(buckets, estimate, form),
      Tour.UI.promql(expr)
    ])
  end

  defp steps(%{upper: :inf} = e) do
    """
    1. Lookups in the window: **#{n(e.total)}**. The `+Inf` bucket counts all of them.
    2. The rank: #{e.q} × #{n(e.total)} = **#{n(e.rank)}**.
    3. Only #{n(e.below)} lookups are at or under the last finite edge, #{Tour.UI.ms(e.lower)}, so the rank is past it.
    4. Prometheus can't see past that edge, so it answers with the edge itself: **#{Tour.UI.ms(e.value)}**.
    """
  end

  defp steps(e) do
    fraction = (e.rank - e.below) / (e.at_upper - e.below)

    """
    1. Lookups in the window: **#{n(e.total)}**. The `+Inf` bucket counts all of them, and `increase()` extrapolates to the window's edges, which is why the counts have decimals.
    2. The rank: #{e.q} × #{n(e.total)} = **#{n(e.rank)}**. Line the lookups up fastest first, and the answer is the latency at that position.
    3. #{n(e.below)} lookups are at or under #{Tour.UI.ms(e.lower)} and #{n(e.at_upper)} at or under #{Tour.UI.ms(e.upper)}, so that lookup is in the #{Tour.UI.ms(e.lower)} to #{Tour.UI.ms(e.upper)} bucket.
    4. Assume the lookups inside it are spread evenly: (#{n(e.rank)} − #{n(e.below)}) / (#{n(e.at_upper)} − #{n(e.below)}) = **#{Float.round(fraction * 100, 1)}%** of the way through.
    5. #{Tour.UI.ms(e.lower)} + #{Float.round(fraction, 3)} × (#{Tour.UI.ms(e.upper)} − #{Tour.UI.ms(e.lower)}) = **#{Tour.UI.ms(e.value)}**.
    """
  end

  defp verdict(estimate, prometheus, guess) do
    check =
      if is_number(prometheus) and abs(prometheus - estimate.value) < 1.0e-9,
        do:
          "#{Tour.UI.mark(:ok)} Prometheus's `histogram_quantile` says **#{precise(prometheus)}**, the same as mine, **#{precise(estimate.value)}**.",
        else:
          "#{Tour.UI.mark(:warn)} Prometheus says #{precise(prometheus)}, I get #{precise(estimate.value)}."

    check <> "\n\n" <> guessed(guess, estimate.value)
  end

  defp guessed(guess, value) when is_number(guess),
    do: "🎯 Your guess was #{guess} ms, off by #{Float.round(abs(guess - value * 1000), 1)} ms."

  defp guessed(_no_guess, _value), do: ""

  defp coarse(_buckets, _estimate, %{edges: :all}), do: Kino.Markdown.new("")

  defp coarse(buckets, estimate, %{edges: edges, q: q}) do
    case Quantile.estimate(q, Quantile.keep_edges(buckets, @edge_sets[edges])) do
      :no_data ->
        Kino.Markdown.new("")

      rough ->
        Tour.UI.note(
          :info,
          "With only those edges, the same lookups give **#{Tour.UI.ms(rough.value)}** instead of #{Tour.UI.ms(estimate.value)}. " <>
            "The latency didn't change. The bucket got wider, and the estimate can be off by up to its width, " <>
            "here #{Tour.UI.ms(rough.lower)} to #{Tour.UI.ms(rough.upper)}."
        )
    end
  end

  defp charts(buckets, estimate) do
    rows =
      buckets
      |> Enum.zip([{0.0, 0} | buckets])
      |> Enum.map(fn {{edge, cumulative}, {_previous, below}} ->
        %{
          "bucket" => label(edge),
          "in this bucket" => cumulative - below,
          "at or under the edge" => cumulative,
          "where" => if(edge == estimate.upper, do: "holds the answer", else: "other")
        }
      end)

    Kino.Layout.grid(
      [
        bars(rows, "in this bucket", "Lookups in each bucket"),
        bars(rows, "at or under the edge", "What Prometheus stores (cumulative)")
      ],
      columns: 2
    )
  end

  defp bars(rows, field, title) do
    Vl.new(width: 330, height: 200, title: title)
    |> Vl.data_from_values(rows)
    |> Vl.mark(:bar)
    |> Vl.encode_field(:x, "bucket",
      type: :ordinal,
      sort: nil,
      title: "upper edge, ms",
      axis: [label_angle: 0]
    )
    |> Vl.encode_field(:y, field, type: :quantitative, title: "lookups")
    |> Vl.encode_field(:color, "where",
      type: :nominal,
      legend: nil,
      scale: [domain: ["holds the answer", "other"], range: ["#e4572e", "#76b7b2"]]
    )
  end

  defp prometheus_value([%{value: value} | _rest]), do: value
  defp prometheus_value([]), do: :nan

  defp label(:inf), do: "+Inf"

  defp label(edge) do
    ms = Float.round(edge * 1000, 3)
    if ms == trunc(ms), do: Integer.to_string(trunc(ms)), else: Float.to_string(ms)
  end

  defp n(number) when is_number(number), do: :erlang.float_to_binary(number * 1.0, decimals: 1)

  defp precise(seconds) when is_number(seconds), do: "#{Float.round(seconds * 1000.0, 3)} ms"
  defp precise(other), do: inspect(other)
end
```

